.DS_Store

# jj already skips decisions/ on its own because it contains a .jj directory.
# The colocated git does not: without this line `git status` reports
# `?? decisions/`, and `git add -A` embeds it as a gitlink. The decision layer
# is an independent repository (decisions/SPEC.md §1) and must stay invisible
# here (§2).
/decisions/

# The board is a third repository for the same reason, and a louder one: a task
# is a file, so a morning of moving tasks is a morning of commits that say
# nothing about folio. Ignored before it exists, so that no command snapshots it
# into this working copy first.
/kanban/

/target
.folio/
/benchmarks/corpora/
/benchmarks/reports/

__pycache__/
